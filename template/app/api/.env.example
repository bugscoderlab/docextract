# Copy to .env and fill in. main.py loads .env via python-dotenv.

# --- app ---
# PostgreSQL in production (psycopg2 driver, per requirements.txt); SQLite
# works for a local spin (e.g. sqlite:///./dev.db).
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/app
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- extraction engine (provider config: docextract.config) ---
# "provider:model" in one var wins over EXTRACTION_PROVIDER.
EXTRACTION_MODEL=google_genai:gemini-2.5-flash
EXTRACTION_PROVIDER=google_genai
EXTRACTION_TEMPERATURE=0.0
# EXTRACTION_MAX_TOKENS=
# EXTRACTION_TIMEOUT=120

# Provider API key (google_genai reads GOOGLE_API_KEY).
GOOGLE_API_KEY=

# --- upload / storage ---
# Max upload size in bytes (default 25 MiB).
# UPLOAD_MAX_BYTES=26214400
# Document bytes: disk (default) | s3 | off.
DOCUMENT_STORAGE=disk
# DOCUMENT_STORAGE_DIR=./data/documents
# S3_BUCKET=
# S3_PREFIX=
# S3_ENDPOINT_URL=
