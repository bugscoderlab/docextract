{
  "name": "@docextract/ui",
  "version": "0.1.0",
  "description": "A domain-free review UI for a docextract backend: drop → extract → correct → approve → workbook.",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": ["src"],
  "scripts": {
